# Discord Bot Token (Developer Portal → Bot → Token)
DISCORD_BOT_TOKEN=

# Discord OAuth App (Developer Portal → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Where Discord should redirect after user login
# Must be whitelisted in Discord Developer Portal → OAuth2 → Redirects
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# Frontend origin (used for the post-auth redirect and CORS)
FRONTEND_URL=http://127.0.0.1:5173

# Port for the combined HTTP + WebSocket server
PORT=3001
