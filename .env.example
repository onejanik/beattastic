# ── Spotify ──────────────────────────────────────────────────────────────────
# Developer Dashboard → https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=dein_client_id_hier
# Muss exakt im Spotify Developer Dashboard als Redirect URI stehen
VITE_REDIRECT_URI=http://127.0.0.1:5173/callback

# ── Discord Bot Server ────────────────────────────────────────────────────────
# HTTP-Basis-URL des Bot-Servers (ohne trailing slash)
# z.B. https://api.beattastic.app  oder  http://localhost:3001
VITE_BOT_URL=http://localhost:3001

# WebSocket-URL des Bot-Servers (ws:// oder wss://)
# z.B. wss://api.beattastic.app  oder  ws://localhost:3001
VITE_BOT_WS_URL=ws://localhost:3001
